{
  "name": "playlist-q",
  "type": "module",
  "version": "1.0.0",
  "main": "server/index.js",
  "description": "queue up your music for your day of coding",
  "engines": {
    "node": "18.20.5"
  },
  "scripts": {
    "watch-css": "node-sass -w react-ui/src/styles/scss -o react-ui/src/styles/css",
    "start-prod": "NODE_ENV=production node server/index.js",
    "start": "NODE_ENV=production pm2 start server/index.js --name music-db",
    "dev-local": "NODE_ENV=development node server/server-local.js",
    "dev": "NODE_ENV=development pm2 start server/index.js --name music-db",
    "dev-netlify": "netlify dev --dir react-ui/build --offline",
    "dev-netlify-proxy-with-frontend": "netlify dev --offline",
    "dev-netlify-with-react": "concurrently -n \"react,netlify\" -c \"blue,green\" \"cd react-ui && BROWSER=none PORT=3000 npm start\" \"wait-on http://localhost:3000 -t 30000 && netlify dev --offline\"",
    "dev-frontend": "cd react-ui && NODE_OPTIONS=--openssl-legacy-provider npm start"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "1.20.2",
    "chalk": "^5.1.2",
    "classnames": "^2.2.5",
    "cors": "^2.8.5",
    "dotenv": "^5.0.1",
    "express": "^4.14.1",
    "immutability-helper": "^2.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^6.8.0",
    "morgan": "^1.9.0",
    "nodemailer": "^7.0.12",
    "react-hover-image": "^1.0.0",
    "react-sortable-hoc": "^2.0.0",
    "serverless-http": "^3.2.0",
    "spotify-web-api-node": "^3.1.1"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "node",
    "heroku",
    "create-react-app",
    "react"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "node-sass": "^8.0.0",
    "wait-on": "^7.2.0"
  }
}
