{
    "name": "music-db",
    "version": "1.0.0",
    "description": "queue up your music for your day of coding, or whaterver",
    "engines": {
        "node": "8.9.x"
    },
    "scripts": {
        "start": "NODE_ENV=production node server",
        "watch-css": "node-sass -w react-ui/src/styles/scss -o react-ui/src/styles/css",
        "dev": "NODE_ENV=development node server",
        "heroku-postbuild": "cd react-ui/ && npm install && npm install --only=dev --no-shrinkwrap && npm run build"
    },
    "cacheDirectories": [
        "node_modules",
        "react-ui/node_modules"
    ],
    "dependencies": {
        "body-parser": "^1.18.3",
        "classnames": "^2.2.5",
        "dotenv": "^5.0.1",
        "express": "^4.14.1",
        "immutability-helper": "^2.7.0",
        "mongoose": "^5.1.1",
        "morgan": "^1.9.0",
        "react-hover-image": "^1.0.0",
        "spotify-web-api-node": "^3.1.1"
    },
    "repository": {
        "type": "git",
        "url": ""
    },
    "keywords": [
        "node",
        "heroku",
        "create-react-app",
        "react"
    ],
    "license": "MIT",
    "devDependencies": {
        "node-sass": "^4.9.0"
    }
}
